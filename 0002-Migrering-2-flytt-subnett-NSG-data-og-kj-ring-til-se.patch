--- a/stacks/app/main.tf
+++ b/stacks/app/main.tf
@@ -1,50 +1,18 @@
-# Applaget for ALLE tjenestene: en VM eller en web app per tjeneste, koblet til
-# subnettet som network-stacken har laget for den.
+# Tømt under migreringen. VM-en og web app-en eies nå av hver sin instans
+# av service. Stacken slettes i opprydnings-PR-en.
 
-data "terraform_remote_state" "network" {
-  backend = "azurerm"
-  config = {
-    resource_group_name  = var.state_resource_group_name
-    storage_account_name = var.state_storage_account_name
-    container_name       = var.state_container_name
-    key                  = "oblig2/${var.miljo}/network.tfstate"
-    use_azuread_auth     = true
-  }
-}
+removed {
+  from = module.vm
 
-locals {
-  network = data.terraform_remote_state.network.outputs
-
-  tags = {
-    eier  = var.kortnavn
-    miljo = var.miljo
-    kurs  = "dcst3005-oblig2"
+  lifecycle {
+    destroy = false
   }
 }
 
-module "vm" {
-  source   = "../../modules/vm"
-  for_each = { for navn, runtime in var.tjenester : navn => runtime if runtime == "vm" }
+removed {
+  from = module.webapp
 
-  service             = each.key
-  resource_group_name = local.network.resource_group_name
-  location            = var.location
-  subnet_id           = local.network.subnet_ids[each.key]
-  size                = var.vm_size
-  ssh_public_key      = var.ssh_public_key
-  tags                = local.tags
-}
-
-module "webapp" {
-  source   = "../../modules/webapp"
-  for_each = { for navn, runtime in var.tjenester : navn => runtime if runtime == "webapp" }
-
-  service             = each.key
-  kortnavn            = var.kortnavn
-  miljo               = var.miljo
-  resource_group_name = local.network.resource_group_name
-  location            = var.location
-  subnet_id           = local.network.subnet_ids[each.key]
-  sku                 = var.webapp_sku
-  tags                = local.tags
+  lifecycle {
+    destroy = false
+  }
 }
