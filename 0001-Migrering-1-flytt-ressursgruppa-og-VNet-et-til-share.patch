diff --git a/stacks/shared-network/import.tf b/stacks/shared-network/import.tf
new file mode 100644
index 0000000..16f0b2c
--- /dev/null
+++ b/stacks/shared-network/import.tf
@@ -0,0 +1,19 @@
+# MIDLERTIDIG: flytter ressursgruppa og VNet-et hit fra network-stacken.
+# network har removed med destroy = false for de samme ressursene.
+# Slettes i opprydnings-PR-en (K8).
+#
+# ID-ene bygges, de skrives ikke av (K5): abonnementet kommer fra
+# data-kilden, ikke fra koden.
+
+# tflint-ignore: terraform_unused_declarations # Brukes bare av import-blokkene under
+data "azurerm_subscription" "current" {}
+
+import {
+  to = azurerm_resource_group.this
+  id = "${data.azurerm_subscription.current.id}/resourceGroups/${local.rg_navn}"
+}
+
+import {
+  to = module.vnet.azurerm_virtual_network.this
+  id = "${data.azurerm_subscription.current.id}/resourceGroups/${local.rg_navn}/providers/Microsoft.Network/virtualNetworks/${local.vnet_navn}"
+}
diff --git a/stacks/shared-network/main.tf b/stacks/shared-network/main.tf
new file mode 100644
index 0000000..2258cff
--- /dev/null
+++ b/stacks/shared-network/main.tf
@@ -0,0 +1,28 @@
+# Det tjenestene faktisk deler: ressursgruppa og VNet-et. Subnettene eies av
+# hver sin instans av stacks/service.
+
+locals {
+  rg_navn   = "rg-${var.kortnavn}-oblig2-${var.miljo}"
+  vnet_navn = "vnet-${var.kortnavn}-${var.miljo}"
+
+  tags = {
+    eier  = var.kortnavn
+    miljo = var.miljo
+    kurs  = "dcst3005-oblig2"
+  }
+}
+
+resource "azurerm_resource_group" "this" {
+  name     = local.rg_navn
+  location = var.location
+  tags     = local.tags
+}
+
+module "vnet" {
+  source              = "../../modules/vnet"
+  name                = local.vnet_navn
+  resource_group_name = azurerm_resource_group.this.name
+  location            = azurerm_resource_group.this.location
+  address_space       = var.address_space
+  tags                = local.tags
+}
diff --git a/stacks/shared-network/outputs.tf b/stacks/shared-network/outputs.tf
new file mode 100644
index 0000000..32963d5
--- /dev/null
+++ b/stacks/shared-network/outputs.tf
@@ -0,0 +1,24 @@
+output "resource_group_name" {
+  description = "Ressursgruppa alle tjenestene står i."
+  value       = azurerm_resource_group.this.name
+}
+
+output "resource_group_id" {
+  description = "Ressurs-ID-en til ressursgruppa. Service-stacken bygger import-ID-ene sine fra den."
+  value       = azurerm_resource_group.this.id
+}
+
+output "location" {
+  description = "Regionen alt står i."
+  value       = azurerm_resource_group.this.location
+}
+
+output "vnet_name" {
+  description = "Navnet på VNet-et."
+  value       = module.vnet.name
+}
+
+output "vnet_id" {
+  description = "Ressurs-ID-en til VNet-et."
+  value       = module.vnet.id
+}
diff --git a/stacks/shared-network/variables.tf b/stacks/shared-network/variables.tf
new file mode 100644
index 0000000..27b4d76
--- /dev/null
+++ b/stacks/shared-network/variables.tf
@@ -0,0 +1,29 @@
+variable "kortnavn" {
+  description = "Kortnavnet ditt. Settes i config/felles.tfvars."
+  type        = string
+
+  validation {
+    condition     = can(regex("^[a-z0-9]{2,10}$", var.kortnavn))
+    error_message = "kortnavn må være 2–10 små bokstaver eller tall. Sett det i config/felles.tfvars."
+  }
+}
+
+variable "location" {
+  description = "Azure-regionen. Settes i config/felles.tfvars."
+  type        = string
+}
+
+variable "miljo" {
+  description = "Miljøet. Settes av scripts/kjor.sh (TF_VAR_miljo), ikke i en .tfvars-fil."
+  type        = string
+
+  validation {
+    condition     = contains(["dev", "prod"], var.miljo)
+    error_message = "miljo må være dev eller prod."
+  }
+}
+
+variable "address_space" {
+  description = "Adresserommet til VNet-et."
+  type        = list(string)
+}
diff --git a/stacks/shared-network/versions.tf b/stacks/shared-network/versions.tf
new file mode 100644
index 0000000..6887fb8
--- /dev/null
+++ b/stacks/shared-network/versions.tf
@@ -0,0 +1,19 @@
+terraform {
+  required_version = ">= 1.16.0"
+
+  # Tom med vilje. Adressen kommer fra shared/backend.hcl, og key fra
+  # scripts/kjor.sh: oblig2/<miljø>/<navn på config-fila>.tfstate
+  backend "azurerm" {}
+
+  required_providers {
+    azurerm = {
+      source  = "hashicorp/azurerm"
+      version = "~> 5.4"
+    }
+  }
+}
+
+# Abonnementet kommer fra ARM_SUBSCRIPTION_ID, ikke fra koden.
+provider "azurerm" {
+  features {}
+}
